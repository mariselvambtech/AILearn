}

.toolbar-actions {
    display: flex;
    gap: 0.5rem;
}

/* ===== Automation cards ===== */
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
}

.card {
    background: var(--bg-card);
    border: 1px solid var(--border);
