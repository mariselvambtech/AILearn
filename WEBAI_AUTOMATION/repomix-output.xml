/* ===== WebAI Dashboard — modern dark theme ===== */
:root {
    --bg: #0f1420;
    --bg-panel: #171e2e;
    --bg-card: #1d2639;
    --bg-hover: #243050;
    --border: #2b3answer852;
    --border: #2b3852;
    --text: #e8ecf4;
    --text-muted: #93a0b8;
    --primary: #4f7cff;
    --primary-hover: #3b66e0;
    --accent: #8b5cf6;
    --success: #22c55e;
    --danger: #ef4444;
    --warning: #f59e0b;
    --radius: 12px;
    --shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
}

.hidden {
    display: none !important;
}

.muted {
    color: var(--text-muted);
}

.hint {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
}

/* ===== Header ===== */
.app-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.5rem;
    background: var(--bg-panel);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.header-left {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
}

.logo {
    font-size: 1.35rem;
    font-weight: 700;
}

.header-subtitle {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.health-badges {
    display: flex;
    gap: 0.5rem;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--text-muted);
}

.badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-muted);
}

.badge.online .dot {
    background: var(--success);
    box-shadow: 0 0 6px var(--success);
}

.badge.online {
    color: var(--text);
}

.badge.offline .dot {
    background: var(--danger);
}

.auth-area {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.user-chip {
    padding: 0.3rem 0.8rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
}

/* ===== Buttons ===== */
.btn {
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
    border: 1px solid transparent;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, transform 0.05s;
}

.btn:active {
    transform: scale(0.97);
}

.btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.btn-primary {
    background: var(--primary);
    color: #fff;
}

.btn-primary:hover:not(:disabled) {
    background: var(--primary-hover);
}

.btn-accent {
    background: var(--accent);
    color: #fff;
}

.btn-accent:hover:not(:disabled) {
    background: #7c4de8;
}

.btn-success {
    background: var(--success);
    color: #fff;
}

.btn-success:hover:not(:disabled) {
    background: #1ba34d;
}

.btn-ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
}

.btn-ghost:hover:not(:disabled) {
