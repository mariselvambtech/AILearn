        monkeypatch.setattr(requests, "get", fake_get)
        resp = client.get("/api/automations", headers=AUTH_HEADERS)
        assert resp.status_code == 502

    def test_login_forwards_credentials(self, monkeypatch: pytest.MonkeyPatch) -> None:
